---
import site from '../../data/site.json';
import Base from '../../layouts/Base.astro';
import { isPublished } from '../../lib/content';
import { getCollection } from 'astro:content';
import { getAllTags } from '../../lib/graph';
import { originalsOnly } from '../../lib/i18n';

const projects = originalsOnly(await getCollection('projects', isPublished))
  .sort((a, b) => a.data.order - b.data.order);

// Projects are the evergreen layer, so they're grouped by topic rather than
// listed by date — you enter through what a thing is about.
const tags = await getAllTags();
const byTag = tags.filter((t) => t.projects > 0);

const pad = (n) => String(n).padStart(2, '0');
const statusLabel = { active: 'In progress', shipped: 'Shipped', archived: 'Archived' };

const c = site.projectsPage;
---
<Base title="Projects — Nyan Lynn Tun" description="Data platform case studies: lakehouse architecture, pipelines, and SAP integration.">
  <div class="shell">
    <header class="head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.heading}</h1>
      <p class="lede">{c.lede}</p>
    </header>

    <div class="rows">
      {projects.map((p, i) => (
        <a class="row" href={`/projects/${p.slug}/`}>
          <span class="row-idx">{pad(i + 1)}</span>
          <div>
            <div class="row-title">{p.data.title}</div>
            <p class="row-desc">{p.data.summary}</p>
            {p.data.tags.length > 0 && (
              <div class="taglist" style="margin-top: 12px;">
                {p.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            )}
          </div>
          <span class="row-side">
            {statusLabel[p.data.status]}{'\n'}{p.data.stack.slice(0, 2).join('\n')}
          </span>
        </a>
      ))}
    </div>

    {projects.length === 0 && (
      <p class="empty">No projects published yet. Add one in the CMS at <code>/admin</code>.</p>
    )}

    {byTag.length > 0 && (
      <section class="topics">
        <div class="sec-head"><b>By topic</b><i></i></div>
        <div class="taglist">
          {byTag.map((t) => (
            <a class="tag" href={`/tags/${t.tag}/`}>{t.tag} <span class="tag-count">{t.projects}</span></a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .head { padding: 84px 0 48px; }
  .head h1 { font-size: clamp(34px, 5.2vw, 54px); line-height: 1.05; margin: 20px 0 18px; max-width: 17ch; }
  .lede { font-size: 17px; line-height: 1.7; color: var(--mute); max-width: 56ch; }
  .empty { font-size: 14.5px; color: var(--faint); padding: 30px 0; }
  .topics { margin-top: 76px; padding-top: 8px; }
  .row-side { white-space: pre-line; }
</style>
