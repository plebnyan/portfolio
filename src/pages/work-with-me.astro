---
import Base from "../layouts/Base.astro";

const services = [
  { h: "Build a pipeline", p: "Design and ship reliable batch or streaming ingestion + transformation on Azure / Databricks." },
  { h: "Lakehouse & modelling", p: "Stand up a medallion lakehouse, model your data, and build marts your analysts can trust." },
  { h: "Data reliability review", p: "Audit an existing setup for quality, cost, and maintainability — and a plan to fix it." },
];
const mail = "mailto:hello@nyanlynntun.com";
// Cal.com username — the "Book a call" button opens this scheduler in a popup.
const calLink = "plebnyan";
---
<Base title="Work with me — Nyan Lynn Tun">
  <section class="container">
    <div class="page-head">
      <div class="page-label">Work with me</div>
      <h1>Consulting on <strong>data platforms</strong></h1>
      <p class="lead">I help teams build data infrastructure they can rely on — pipelines, lakehouse architecture, and the modelling that makes everything downstream possible. If your data is slow, messy, or untrusted, that's the work I do.</p>
    </div>
  </section>

  <section class="container block" style="padding-top: 40px;">
    <div class="section-header"><span class="section-num">01</span><span class="section-title">How I can help</span><div class="section-line"></div></div>
    <div class="services">
      {services.map((s) => (
        <div class="service"><h3>{s.h}</h3><p>{s.p}</p></div>
      ))}
    </div>
  </section>

  <section class="container block">
    <div class="section-header"><span class="section-num">02</span><span class="section-title">Book a call</span><div class="section-line"></div></div>
    <div class="cta-box">
      <p>Tell me what you're building and where it hurts. A 30-minute call, no charge, to see if I can help.</p>
      <div class="cta-links">
        <button class="btn btn-primary" style="border: 0;" data-cal-link={calLink} data-cal-config='{"layout":"month_view"}'>Book a 30-min call</button>
        <a class="btn btn-ghost" href={mail}>Email instead</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", { origin: "https://cal.com" });
    Cal("ui", { hideEventTypeDetails: false, layout: "month_view" });
  </script>
</Base>
