---
import Base from '../layouts/Base.astro';
import Lineage from '../components/Lineage.astro';
import Bio from '../components/Bio.astro';
import { isPublished } from '../lib/content';
import { getCollection } from 'astro:content';
import { getAllTags } from '../lib/graph';
import { originalsOnly } from '../lib/i18n';
import site from '../data/site.json';

const c = site.home;

const projects = originalsOnly(await getCollection('projects', isPublished))
  .sort((a, b) => a.data.order - b.data.order);

const posts = originalsOnly(await getCollection('blog', isPublished))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const tags = (await getAllTags()).slice(0, 10);

const fmtYear = (d) => d.getFullYear();
const pad = (n) => String(n).padStart(2, '0');
---
<Base>
  <section class="hero">
    <Lineage />
    <div class="shell hero-in">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.headline} <b>{c.headlineAccent}</b></h1>
      <p class="hero-lede">{c.lede}</p>
      <div class="btn-row hero-btns">
        <a class="btn btn-primary" href="/projects">{c.primaryCta}</a>
        <a class="btn" href="/blog">{c.secondaryCta}</a>
      </div>
    </div>
  </section>

  <div class="shell">
    <section class="block">
      <div class="sec-head">
        <b>Projects</b><i></i>
        <span>{projects.length} {projects.length === 1 ? 'case study' : 'case studies'}</span>
      </div>
      <div class="rows">
        {projects.map((p, i) => (
          <a class="row" href={`/projects/${p.slug}/`}>
            <span class="row-idx">{pad(i + 1)}</span>
            <div>
              <div class="row-title">{p.data.title}</div>
              <p class="row-desc">{p.data.summary}</p>
            </div>
            <span class="row-side">{p.data.stack.slice(0, 2).join('\n')}</span>
          </a>
        ))}
      </div>
      {projects.length === 0 && <p class="empty">No projects published yet.</p>}
    </section>

    <section class="block">
      <div class="sec-head"><b>Writing</b><i></i><span>Recent</span></div>
      <div class="rows">
        {posts.map((p) => (
          <a class="row" href={`/blog/${p.slug}/`}>
            <span class="row-idx">{fmtYear(p.data.date)}</span>
            <div>
              <div class="row-title">{p.data.title}</div>
              <p class="row-desc">{p.data.excerpt}</p>
            </div>
            <span class="row-side">{p.data.tags.slice(0, 2).join('\n')}</span>
          </a>
        ))}
      </div>
      {posts.length === 0 && <p class="empty">No posts published yet.</p>}
      {posts.length > 0 && (
        <div class="btn-row" style="margin-top: 28px;">
          <a class="btn" href="/blog">All posts</a>
        </div>
      )}
    </section>

    {tags.length > 0 && (
      <section class="block">
        <div class="sec-head"><b>Topics</b><i></i><span>Posts &amp; projects together</span></div>
        <div class="taglist">
          {tags.map((t) => (
            <a class="tag" href={`/tags/${t.tag}/`}>{t.tag} <span class="tag-count">{t.total}</span></a>
          ))}
        </div>
      </section>
    )}

    <section class="block closing">
      <h2>{c.closingHeading}</h2>
      <p>{c.closingText}</p>
      <div class="btn-row"><a class="btn btn-primary" href={`mailto:${site.identity.email}`}>{site.identity.email}</a></div>
    </section>
    <Bio />
  </div>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero-in { position: relative; z-index: 1; padding: 104px 30px 112px; }
  .hero h1 {
    font-size: clamp(46px, 8vw, 92px); line-height: .95; letter-spacing: -.035em;
    margin: 26px 0 26px; max-width: 13ch; font-weight: 700;
    font-variation-settings: 'wdth' 88;
  }
  .hero h1 b { display: block; color: var(--accent); font-weight: 700; }
  .hero-lede { font-size: 18px; line-height: 1.62; color: var(--mute); max-width: 46ch; }
  .hero-btns { margin-top: 34px; }

  .block { padding: 76px 0; border-bottom: 1px solid var(--line); }
  .block:last-child { border-bottom: 0; }
  .empty { font-size: 14.5px; color: var(--faint); }

  .closing h2 { font-size: clamp(26px, 3.6vw, 38px); margin-bottom: 14px; max-width: 20ch; }
  .closing p { font-size: 16.5px; color: var(--mute); max-width: 46ch; margin-bottom: 28px; }

  .row-side { white-space: pre-line; }
</style>
