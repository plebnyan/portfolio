---
import Base from '../../layouts/Base.astro';
import Backlinks from '../../components/Backlinks.astro';
import Toc from '../../components/Toc.astro';
import { isPublished } from '../../lib/content';
import { getCollection } from 'astro:content';
import { isTranslation, translationSlug } from '../../lib/i18n';

export async function getStaticPaths() {
  const all = await getCollection('blog', isPublished);
  return all
    .filter((p) => !isTranslation(p.slug))
    .map((p) => ({
      params: { slug: p.slug },
      props: { post: p, my: all.find((t) => t.slug === translationSlug(p.slug)) ?? null },
    }));
}

const { post, my } = Astro.props;
const d = post.data;
const { Content, headings } = await post.render();
const My = my ? (await my.render()).Content : null;
const hasMy = !!My;
const fmt = (dt) => dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const iso = d.date.toISOString();
---
<Base title={`${d.title} — Nyan Lynn Tun`} description={d.excerpt}>
  <div class="read" data-lang-root data-lang="en">
    <a class="back" href="/blog">← Blog</a>

    <header class="head">
      <p class="meta"><time datetime={iso}>{fmt(d.date)}</time></p>
      <h1 data-title-en={d.title} data-title-my={my ? my.data.title : d.title}>{d.title}</h1>

      <div class="lang-pane active" data-lang="en"><p class="lede">{d.excerpt}</p></div>
      {hasMy && (
        <div class="lang-pane" data-lang="my"><p class="lede my-title">{my.data.excerpt}</p></div>
      )}

      <div class="head-foot">
        {d.tags.length > 0 && (
          <div class="taglist">{d.tags.map((t) => <a class="tag" href={`/tags/${t}/`}>{t}</a>)}</div>
        )}
        {hasMy && (
          <div class="lang-toggle">
            <button data-lang="en" class="active" aria-pressed="true">EN</button>
            <button data-lang="my" aria-pressed="false">မြန်မာ</button>
          </div>
        )}
      </div>
    </header>

    {d.cover && <img class="cover" src={d.cover} alt="" loading="lazy" />}

    <article>
      <Toc headings={headings} />
      <div class="lang-pane active" data-lang="en"><div class="prose"><Content /></div></div>
      {hasMy && <div class="lang-pane" data-lang="my"><div class="prose"><My /></div></div>}
    </article>

    <Backlinks collection="blog" slug={post.slug} />
  </div>
</Base>

<style>
  .back { font-family: var(--mono); font-size: 12px; color: var(--mute); text-decoration: none; display: inline-block; padding-top: 44px; }
  .back:hover { color: var(--accent); }

  .head { padding: 26px 0 0; border-bottom: 1px solid var(--line); padding-bottom: 26px; }
  .head h1 {
    font-size: calc(clamp(32px, 5vw, 48px) * var(--title-scale, 1));
    line-height: var(--title-lh, 1.08);
    margin: 14px 0 18px;
  }
  .lede { font-size: 18.5px; line-height: 1.65; color: var(--mute); }
  .head-foot { display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 26px; }

  .cover { width: 100%; height: auto; display: block; border: 1px solid var(--line); margin-top: 34px; }
  article { padding-top: 20px; }
</style>
