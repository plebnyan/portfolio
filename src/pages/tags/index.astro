---
import site from '../../data/site.json';
import Base from '../../layouts/Base.astro';
import { getAllTags } from '../../lib/graph';

const tags = await getAllTags();

const c = site.tagsPage;
---
<Base title="Topics — Nyan Lynn Tun" description="Every topic across posts and projects.">
  <div class="shell">
    <header class="head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.heading}</h1>
      <p class="lede">{c.lede}</p>
    </header>

    <div class="tag-rows">
      {tags.map((t) => (
        <a class="tag-row" href={`/tags/${t.tag}/`}>
          <span class="tr-name">{t.tag}</span>
          <span class="tr-line"></span>
          <span class="tr-counts">
            {t.projects > 0 && <b>{t.projects} project{t.projects === 1 ? '' : 's'}</b>}
            {t.projects > 0 && t.posts > 0 && <em>·</em>}
            {t.posts > 0 && <b>{t.posts} post{t.posts === 1 ? '' : 's'}</b>}
          </span>
        </a>
      ))}
    </div>

    {tags.length === 0 && <p class="empty">No tags yet — add some to a post or project.</p>}
  </div>
</Base>

<style>
  .head { padding: 84px 0 48px; }
  .head h1 { font-size: clamp(34px, 5.2vw, 54px); line-height: 1.05; margin: 20px 0 18px; }
  .lede { font-size: 17px; line-height: 1.7; color: var(--mute); max-width: 54ch; }
  .empty { font-size: 14.5px; color: var(--faint); }

  .tag-rows { display: flex; flex-direction: column; }
  .tag-row {
    display: flex; align-items: baseline; gap: 18px; padding: 17px 0;
    border-top: 1px solid var(--line); text-decoration: none; transition: border-color .15s;
  }
  .tag-row:first-child { border-top: 1px solid var(--line2); }
  .tag-row:hover { border-top-color: var(--accent); }
  .tag-row:hover .tr-name { color: var(--accent-hi); }
  .tr-name { font-family: var(--display); font-size: 19px; font-weight: 500; color: var(--ink); letter-spacing: -.01em; transition: color .15s; }
  .tr-line { flex: 1; height: 1px; background: var(--line); }
  .tr-counts { font-family: var(--mono); font-size: 11.5px; color: var(--faint); display: flex; gap: 7px; }
  .tr-counts b { font-weight: 400; color: var(--mute); }
  .tr-counts em { font-style: normal; }
</style>
