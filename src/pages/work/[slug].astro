---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p, all: projects } }));
}

const { project, all } = Astro.props;
const d = project.data;
let related = d.related && d.related.length
  ? all.filter((p) => d.related.includes(p.slug))
  : all.filter((p) => p.slug !== project.slug);
related = related.slice(0, 2);
---
<Base title={`${d.title} — Nyan Lynn Tun`}>
  <div class="container-wide" style="padding-top: 72px;">
    <a class="back-link" href="/work">← Work</a>
    <div class="proj-layout" style="margin-top: 8px;">

      <div class="proj-main">
        <h1 class="proj-title">{d.title}</h1>
        <p class="proj-sub">{d.summary}</p>
        <div class="proj-stack">
          {d.featured && <span class="tag tag-accent">Featured</span>}
          {d.stack.map((t) => <span class="tag">{t}</span>)}
        </div>

        {d.problems.length > 0 && (
          <div class="proj-section">
            <h2><span class="num">01</span> Problems it solves</h2>
            <ul class="problem-list">{d.problems.map((p) => <li>{p}</li>)}</ul>
          </div>
        )}

        {d.dataModelImage && (
          <div class="proj-section">
            <h2><span class="num">02</span> Data model</h2>
            <div class="figure">
              <img src={d.dataModelImage} alt={`${d.title} data model`} />
              <div class="figcap">Data model — how the tables fit together</div>
            </div>
          </div>
        )}

        <div class="proj-section">
          <h2><span class="num">03</span> Live dashboard</h2>
          {d.dashboardUrl ? (
            <div class="browser">
              <div class="browser-bar"><i></i><i></i><i></i><span class="browser-url">{d.dashboardUrl}</span></div>
              <div class="browser-body" style="padding: 0;"><iframe src={d.dashboardUrl} loading="lazy" title="Live dashboard"></iframe></div>
            </div>
          ) : (
            <div class="browser">
              <div class="browser-bar"><i></i><i></i><i></i><span class="browser-url">dashboard coming soon</span></div>
              <div class="browser-body"><p style="font-family: var(--mono); font-size: 12px; color: var(--faint); margin: 0;">Add a dashboard URL in the CMS to embed a live, interactive view here.</p></div>
            </div>
          )}
        </div>

        {(d.repoUrl || d.quality.length > 0) && (
          <div class="proj-section">
            <h2><span class="num">04</span> Code &amp; quality</h2>
            <div class="repo-box">
              {d.repoUrl && (
                <a class="repo-head" href={d.repoUrl} target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.54-1.38-1.33-1.74-1.33-1.74-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016 0c2.28-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
                  {d.repoUrl.replace("https://", "")}
                </a>
              )}
              <ul class="check-list">{d.quality.map((q) => <li>{q}</li>)}</ul>
            </div>
          </div>
        )}
      </div>

      <aside class="proj-side">
        {related.length > 0 && <div class="side-title">You may also like</div>}
        {related.map((r) => (
          <a class="mini-card" href={`/work/${r.slug}`}>
            {r.data.stack[0] && <div class="mini-meta">{r.data.stack[0]}</div>}
            <div class="mini-title">{r.data.title}</div>
            <div class="mini-desc">{r.data.summary.slice(0, 90)}…</div>
          </a>
        ))}
        <div class="side-cta">
          <p>Like what you see? I take on consulting work building exactly this kind of platform.</p>
          <a class="btn btn-primary" href="/work-with-me" style="width: 100%; justify-content: center;">Work with me</a>
        </div>
      </aside>

    </div>
  </div>
</Base>
