---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work — Nyan Lynn Tun">
  <section class="container">
    <div class="page-head">
      <div class="page-label">Work</div>
      <h1>Selected <strong>projects</strong></h1>
      <p class="lead">Things I've built end to end. Results first, stack second.</p>
    </div>
  </section>

  <section class="container block" style="padding-top: 40px;">
    <div class="card-grid">
      {projects.map((p) => (
        <a class="card" href={`/work/${p.slug}`}>
          <div class="card-title">{p.data.title}</div>
          <p class="card-desc">{p.data.summary}</p>
          <div class="tags">
            {p.data.featured && <span class="tag tag-accent">Featured</span>}
            {p.data.stack.map((t) => <span class="tag">{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
