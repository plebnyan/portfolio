---
const {
  title = "Nyan Lynn Tun — Data Engineer",
  description = "Data Engineer building reliable data platforms, lakehouse architecture and pipelines on Azure & Databricks.",
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href) => (href === "/" ? path === "/" : path.startsWith(href));
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/work", label: "Work" },
  { href: "/blog", label: "Blog" },
  { href: "/work-with-me", label: "Work with me" },
];
const gh = "https://github.com/plebnyan";
const li = "https://www.linkedin.com/in/nyan-lynn-tun-a6aa2a1aa";
const mail = "mailto:hello@nyanlynntun.com";
const canonical = new URL(Astro.url.pathname, "https://nyanlynntun.com").href;
const ogImage = "https://nyanlynntun.com/img/literally_me.jpg";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
  <!-- Open Graph / social link previews -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Noto+Sans+Myanmar:wght@400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #f6f2e9; --bg2: #fbf9f2; --bg3: #eee9dc; --border: #e4dfd1;
      --text: #16181d; --muted: #655f52; --faint: #938c7c;
      --accent: #16a34a; --accent2: #15803d;
      --mono: 'DM Mono', monospace; --sans: 'DM Sans', sans-serif; --serif: 'Newsreader', Georgia, serif;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 15px; line-height: 1.7; -webkit-font-smoothing: antialiased; }
    a { color: inherit; }
    .container { max-width: 760px; margin: 0 auto; padding: 0 24px; }
    .container-wide { max-width: 1080px; margin: 0 auto; padding: 0 24px; }

    nav { position: sticky; top: 0; z-index: 100; background: rgba(246,242,233,.85); backdrop-filter: blur(14px); border-bottom: 1px solid var(--border); }
    nav .inner { display: flex; align-items: center; justify-content: space-between; max-width: 1080px; margin: 0 auto; padding: 0 24px; height: 56px; }
    .nav-logo { display: inline-flex; align-items: center; gap: 9px; font-family: var(--mono); font-size: 13px; color: var(--text); text-decoration: none; letter-spacing: .02em; font-weight: 500; }
    .nav-logo svg { display: block; border-radius: 6px; }
    footer .mark { display: inline-flex; align-items: center; gap: 8px; }
    footer .mark svg { display: block; border-radius: 5px; }
    .nav-links { display: flex; gap: 26px; list-style: none; }
    .nav-links a { font-family: var(--sans); font-size: 14px; color: var(--muted); text-decoration: none; transition: color .15s; }
    .nav-links a:hover { color: var(--text); }
    .nav-links a.active { color: var(--accent); font-weight: 500; }
    main { min-height: 60vh; }

    .section-header { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; padding-top: 68px; }
    .section-num { font-family: var(--mono); font-size: 11px; color: var(--accent); letter-spacing: .1em; }
    .section-title { font-size: 12px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); font-family: var(--mono); }
    .section-line { flex: 1; height: 1px; background: var(--border); }
    .page-head { padding: 72px 0 8px; }
    .page-label { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; display: flex; align-items: center; gap: 10px; }
    .page-label::before { content: ''; display: block; width: 26px; height: 1px; background: var(--accent); }
    h1 { font-family: var(--sans); font-size: clamp(30px, 5.5vw, 44px); font-weight: 600; line-height: 1.12; letter-spacing: -.025em; margin-bottom: 14px; color: var(--text); }
    h1 strong { font-weight: 600; }
    .lead { font-size: 16px; color: var(--muted); max-width: 560px; line-height: 1.8; }

    .btn { font-family: var(--sans); font-size: 14px; font-weight: 500; text-decoration: none; padding: 10px 20px; border-radius: 7px; transition: all .15s; display: inline-flex; align-items: center; gap: 7px; cursor: pointer; }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-primary:hover { background: var(--accent2); }
    .btn-ghost { border: 1px solid var(--border); color: var(--text); background: #fff; }
    .btn-ghost:hover { border-color: #cfc9b8; background: var(--bg2); }
    .btn-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }

    .card-grid { display: flex; flex-direction: column; gap: 12px; }
    .card { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 24px 26px; transition: border-color .15s, box-shadow .15s, transform .15s; display: block; text-decoration: none; }
    .card:hover { border-color: #d8d2c1; box-shadow: 0 6px 24px -12px rgba(0,0,0,.14); transform: translateY(-1px); }
    .card-title { font-size: 16px; font-weight: 600; color: var(--text); margin-bottom: 8px; letter-spacing: -.01em; }
    .card-desc { font-size: 14.5px; color: var(--muted); line-height: 1.75; }
    .card-meta { font-family: var(--mono); font-size: 11px; color: var(--faint); letter-spacing: .04em; margin-bottom: 10px; text-transform: uppercase; }
    .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
    .tag { font-family: var(--mono); font-size: 11px; letter-spacing: .02em; padding: 3px 9px; background: var(--bg3); color: var(--muted); border-radius: 5px; }
    .tag-accent { color: var(--accent2); background: #e7f6ec; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 26px 0 8px; }
    .chip { font-family: var(--mono); font-size: 12px; letter-spacing: .02em; padding: 5px 11px; border: 1px solid var(--border); color: var(--muted); border-radius: 6px; }

    .hero-top { display: flex; align-items: center; gap: 26px; margin-bottom: 22px; }
    .avatar { width: 76px; height: 76px; border-radius: 50%; flex-shrink: 0; border: 1px solid var(--border); overflow: hidden; background: var(--bg3); display: flex; align-items: center; justify-content: center; }
    .avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
    h2.role { font-family: var(--mono); font-size: 14px; font-weight: 400; color: var(--muted); letter-spacing: .02em; }
    .socials { display: flex; gap: 10px; margin-top: 14px; }
    .socials a { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border: 1px solid var(--border); border-radius: 8px; color: var(--muted); background: #fff; transition: .15s; text-decoration: none; }
    .socials a:hover { color: var(--accent); border-color: var(--accent); }
    .socials svg { width: 16px; height: 16px; }

    .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    @media (max-width: 620px) { .services { grid-template-columns: 1fr; } }
    .service { background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; padding: 22px; }
    .service h3 { font-size: 15px; font-weight: 600; margin-bottom: 8px; letter-spacing: -.01em; }
    .service p { font-size: 13.5px; color: var(--muted); line-height: 1.7; }

    .cta-box { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 44px 40px; text-align: center; margin-top: 12px; }
    .cta-box p { font-size: 15px; color: var(--muted); margin-bottom: 24px; max-width: 440px; margin-left: auto; margin-right: auto; line-height: 1.8; }
    .cta-links { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }

    /* BLOG READING */
    .prose { max-width: 660px; }
    .prose p { font-family: var(--serif); font-size: 19px; color: #2b2e35; margin: 22px 0; line-height: 1.75; }
    .prose h2 { font-family: var(--sans); font-size: 24px; font-weight: 600; color: var(--text); margin: 46px 0 14px; letter-spacing: -.02em; }
    .prose h3 { font-family: var(--sans); font-size: 19px; font-weight: 600; margin: 32px 0 8px; letter-spacing: -.01em; }
    .prose ul, .prose ol { font-family: var(--serif); font-size: 18px; color: #2b2e35; margin: 18px 0 18px 22px; line-height: 1.7; }
    .prose li { margin: 6px 0; }
    .prose a { color: var(--accent2); text-decoration: underline; }
    .prose blockquote { border-left: 3px solid var(--accent); padding-left: 16px; margin: 22px 0; color: var(--muted); font-style: italic; }
    .prose img { max-width: 100%; border-radius: 8px; margin: 22px 0; }
    .prose code { font-family: var(--mono); font-size: 14px; background: var(--bg3); padding: 1px 6px; border-radius: 4px; }
    .prose pre { border: 1px solid var(--border); border-radius: 8px; padding: 18px; overflow-x: auto; margin: 24px 0; font-family: var(--mono); font-size: 13.5px; line-height: 1.6; }
    .prose pre code { background: none; padding: 0; font-size: 13.5px; }
    .lang-content[data-lang="my"] p, .lang-content[data-lang="my"] li { font-family: 'Noto Sans Myanmar', sans-serif; font-size: 16px; line-height: 2; }
    .lang-content[data-lang="my"] h2, .lang-content[data-lang="my"] h3 { font-family: 'Noto Sans Myanmar', sans-serif; }
    .lang-toggle { display: inline-flex; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-bottom: 20px; }
    .lang-toggle button { font-family: var(--mono); font-size: 12px; padding: 6px 15px; background: #fff; color: var(--muted); border: none; cursor: pointer; transition: .15s; }
    .lang-toggle button + button { border-left: 1px solid var(--border); }
    .lang-toggle button.active { background: var(--accent); color: #fff; }
    .lang-content { display: none; }
    .lang-content.active { display: block; }

    section.block { padding-bottom: 40px; }

    /* PROJECT DETAIL */
    .proj-layout { display: grid; grid-template-columns: minmax(0,1fr) 296px; gap: 44px; align-items: start; }
    @media (max-width: 900px){ .proj-layout { grid-template-columns: 1fr; gap: 20px; } .proj-side { order: 2; position: static !important; } }
    .proj-main { min-width: 0; }
    .back-link { font-family: var(--mono); font-size: 12px; color: var(--muted); text-decoration: none; }
    .back-link:hover { color: var(--accent); }
    .proj-title { font-family: var(--sans); font-size: clamp(28px,4.5vw,40px); font-weight: 600; letter-spacing: -.025em; margin: 16px 0 12px; line-height: 1.12; }
    .proj-sub { font-size: 16px; color: var(--muted); max-width: 640px; line-height: 1.75; }
    .proj-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
    .proj-section { margin-top: 48px; }
    .proj-section > h2 { font-family: var(--sans); font-size: 12px; text-transform: uppercase; letter-spacing: .09em; color: var(--faint); font-weight: 600; margin-bottom: 18px; display: flex; align-items: center; gap: 10px; }
    .proj-section > h2 .num { font-family: var(--mono); color: var(--accent); }
    .problem-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
    .problem-list li { display: flex; gap: 12px; font-size: 15px; color: #2b2e35; line-height: 1.6; }
    .problem-list li::before { content: '→'; color: var(--accent); font-family: var(--mono); flex-shrink: 0; }
    .figure { border: 1px solid var(--border); border-radius: 12px; background: var(--bg2); padding: 24px; }
    .figure img, .figure svg { width: 100%; height: auto; display: block; }
    .figcap { font-size: 12px; color: var(--faint); margin-top: 14px; text-align: center; font-family: var(--mono); }
    .browser { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: #fff; }
    .browser-bar { background: var(--bg3); border-bottom: 1px solid var(--border); padding: 10px 14px; display: flex; gap: 6px; align-items: center; }
    .browser-bar i { width: 10px; height: 10px; border-radius: 50%; background: #cfc9b8; display: block; }
    .browser-url { margin-left: 12px; font-family: var(--mono); font-size: 11px; color: var(--faint); }
    .browser-body { padding: 22px; }
    .browser-body iframe { width: 100%; height: 480px; border: 0; display: block; }
    .repo-box { border: 1px solid var(--border); border-radius: 12px; padding: 22px 24px; background: #fff; }
    .repo-head { display: flex; align-items: center; gap: 9px; font-family: var(--mono); font-size: 14px; font-weight: 500; margin-bottom: 16px; text-decoration: none; color: var(--text); }
    .repo-head:hover { color: var(--accent); }
    .repo-head svg { width: 18px; height: 18px; flex-shrink: 0; }
    .check-list { list-style: none; display: flex; flex-direction: column; gap: 11px; }
    .check-list li { display: flex; gap: 10px; font-size: 14px; color: var(--muted); line-height: 1.55; }
    .check-list li::before { content: '✓'; color: var(--accent); font-weight: 700; flex-shrink: 0; }
    .proj-side { position: sticky; top: 76px; display: flex; flex-direction: column; gap: 14px; }
    .side-title { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--faint); margin-bottom: 2px; }
    .mini-card { border: 1px solid var(--border); border-radius: 10px; padding: 15px 17px; text-decoration: none; display: block; background: #fff; transition: .15s; }
    .mini-card:hover { border-color: #d8d2c1; box-shadow: 0 6px 20px -12px rgba(0,0,0,.14); }
    .mini-meta { font-family: var(--mono); font-size: 10px; color: var(--accent); letter-spacing: .04em; text-transform: uppercase; margin-bottom: 6px; }
    .mini-title { font-size: 14px; font-weight: 600; margin-bottom: 4px; letter-spacing: -.01em; }
    .mini-desc { font-size: 12.5px; color: var(--muted); line-height: 1.5; }
    .side-cta { border: 1px solid var(--border); border-radius: 10px; padding: 18px; background: var(--bg2); }
    .side-cta p { font-size: 13px; color: var(--muted); margin-bottom: 12px; line-height: 1.6; }

    .related { margin-top: 56px; border-top: 1px solid var(--border); padding-top: 30px; }
    .rel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; }
    @media (max-width: 620px){ .rel-grid { grid-template-columns: 1fr; } }

    footer { border-top: 1px solid var(--border); padding: 28px 0; margin-top: 72px; }
    footer .inner { max-width: 1080px; margin: 0 auto; padding: 0 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    footer p, footer a { font-family: var(--mono); font-size: 11px; color: var(--faint); letter-spacing: .04em; text-decoration: none; }
    footer a:hover { color: var(--accent); }
  </style>
</head>
<body>
  <nav>
    <div class="inner">
      <a class="nav-logo" href="/">
        <svg width="22" height="22" viewBox="0 0 100 100" aria-hidden="true"><rect x="4" y="4" width="92" height="92" rx="22" fill="#16181d"/><text x="20" y="56" dominant-baseline="central" font-family="'DM Mono', monospace" font-size="30" font-weight="500" fill="#f6f2e9">nlt</text><rect x="73" y="40" width="12" height="30" fill="#16a34a"/></svg>
        <span>nyanlynntun.com</span>
      </a>
      <ul class="nav-links">
        {navLinks.map((l) => (
          <li><a href={l.href} class={isActive(l.href) ? "active" : ""}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="inner">
      <p class="mark">
        <svg width="18" height="18" viewBox="0 0 100 100" aria-hidden="true"><rect x="4" y="4" width="92" height="92" rx="22" fill="#16181d"/><text x="20" y="57" dominant-baseline="central" font-family="'DM Mono', monospace" font-size="30" font-weight="500" fill="#f6f2e9">nlt</text><rect x="73" y="40" width="12" height="30" fill="#16a34a"/></svg>
        © 2026 Nyan Lynn Tun
      </p>
      <p>
        <a href={gh} target="_blank" rel="noopener">GitHub</a> ·
        <a href={li} target="_blank" rel="noopener">LinkedIn</a> ·
        <a href={mail}>Email</a>
      </p>
    </div>
  </footer>
</body>
</html>
