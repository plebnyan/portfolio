---
// Author card. Appears at the foot of the homepage and every post/case study,
// so any page someone lands on says who wrote it and where to go next.
import site from '../data/site.json';
const gh = site.identity.github;
const li = site.identity.linkedin;
const mail = `mailto:${site.identity.email}`;
const c = site.bio;
---
<aside class="bio">
  <div class="bio-main">
    <p class="bio-name">{site.identity.name}</p>
    <p class="bio-role">{c.role}</p>
    <p class="bio-text">{c.text}</p>

    <div class="bio-btns">
      <a class="btn btn-primary" href="/about">{c.primaryCta}</a>
      <a class="btn" href="/now">{c.secondaryCta}</a>
    </div>

    <div class="bio-socials">
      <a href={gh} target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.54-1.38-1.33-1.74-1.33-1.74-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016 0c2.28-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href={li} target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 110-4.13 2.06 2.06 0 010 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
      </a>
      <a href={mail} aria-label="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="1"/><path d="m2.5 5.5 9.5 7 9.5-7"/></svg>
      </a>
      <a href="/rss.xml" aria-label="RSS feed">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5.5" cy="18.5" r="2.5"/><path d="M3 10.2v3.1a7.7 7.7 0 017.7 7.7h3.1A10.8 10.8 0 003 10.2zM3 4v3.1c7.7 0 13.9 6.2 13.9 13.9H20C20 11.6 12.4 4 3 4z"/></svg>
      </a>
    </div>
  </div>

  <div class="bio-photo">
    <img src="/img/literally_me.jpg" alt={site.identity.name} loading="lazy" />
  </div>
</aside>

<style>
  .bio {
    display: grid; grid-template-columns: minmax(0,1fr) 232px; gap: 40px;
    background: var(--raise); border: 1px solid var(--line);
    padding: 34px 36px; align-items: center; margin-top: 70px;
  }
  @media (max-width: 760px) {
    .bio { grid-template-columns: 1fr; gap: 26px; padding: 28px 24px; }
    .bio-photo { order: -1; max-width: 180px; }
  }

  .bio-name {
    font-family: var(--display); font-size: 26px; font-weight: 700;
    letter-spacing: -.02em; color: var(--ink);
  }
  .bio-role {
    font-family: var(--mono); font-size: 11.5px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--accent); margin-top: 6px;
  }
  .bio-text {
    font-size: 15.5px; line-height: 1.68; color: var(--mute);
    margin-top: 16px; max-width: 56ch;
  }
  .bio-btns { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }

  .bio-socials { display: flex; gap: 8px; margin-top: 24px; }
  .bio-socials a {
    width: 34px; height: 34px; border: 1px solid var(--line2);
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--mute); transition: .15s;
  }
  .bio-socials a:hover { color: var(--accent-hi); border-color: var(--accent); }
  .bio-socials svg { width: 16px; height: 16px; display: block; }

  .bio-photo img {
    width: 100%; height: auto; display: block;
    border: 1px solid var(--line2); filter: saturate(.85);
  }
</style>
