---
// Ambient data-lineage graph behind the hero. Fixed layout, never random, so it
// always composes the same way — it's set dressing, not navigation.
---
<canvas class="lineage" id="lineage" aria-hidden="true"></canvas>

<style>
  .lineage {
    position: absolute; inset: 0; width: 100%; height: 100%;
    z-index: 0; opacity: .6; pointer-events: none;
  }
</style>

<script is:inline>
  (function () {
    var c = document.getElementById('lineage');
    if (!c || !c.getContext) return;
    var ctx = c.getContext('2d');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var nodes = [
      { x: 0.05, y: 0.28 }, { x: 0.05, y: 0.66 }, { x: 0.23, y: 0.14 },
      { x: 0.25, y: 0.45 }, { x: 0.23, y: 0.80 }, { x: 0.46, y: 0.28 },
      { x: 0.48, y: 0.63 }, { x: 0.67, y: 0.17 }, { x: 0.69, y: 0.47 },
      { x: 0.67, y: 0.82 }, { x: 0.88, y: 0.32 }, { x: 0.90, y: 0.68 }
    ];
    var edges = [[0,2],[0,3],[1,3],[1,4],[2,5],[3,5],[3,6],[4,6],
                 [5,7],[5,8],[6,8],[6,9],[7,10],[8,10],[8,11],[9,11]];
    var pulses = edges.map(function (e, i) {
      return { e: i, t: (i * 0.137) % 1, sp: 0.0014 + (i % 4) * 0.0004 };
    });

    var rect = { width: 0, height: 0 };
    function size() {
      var r = c.getBoundingClientRect();
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      c.width = Math.max(1, Math.round(r.width * dpr));
      c.height = Math.max(1, Math.round(r.height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      rect = r;
    }
    size();
    var ro = window.ResizeObserver ? new ResizeObserver(size) : null;
    if (ro) ro.observe(c); else window.addEventListener('resize', size);

    function p(n) { return { x: n.x * rect.width, y: n.y * rect.height }; }

    function draw() {
      if (!rect.width || !rect.height) { requestAnimationFrame(draw); return; }
      ctx.clearRect(0, 0, rect.width, rect.height);

      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(63,207,117,0.16)';
      for (var i = 0; i < edges.length; i++) {
        var a = p(nodes[edges[i][0]]), b = p(nodes[edges[i][1]]);
        var mx = (a.x + b.x) / 2;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.bezierCurveTo(mx, a.y, mx, b.y, b.x, b.y);
        ctx.stroke();
      }

      for (var j = 0; j < nodes.length; j++) {
        var q = p(nodes[j]);
        ctx.beginPath();
        ctx.arc(q.x, q.y, 2.6, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(63,207,117,0.55)';
        ctx.fill();
      }

      if (reduce) return;

      for (var k = 0; k < pulses.length; k++) {
        var pu = pulses[k], e = edges[pu.e];
        var s = p(nodes[e[0]]), t = p(nodes[e[1]]);
        var cx = (s.x + t.x) / 2;
        var u = pu.t, mu = 1 - u;
        var x = mu*mu*mu*s.x + 3*mu*mu*u*cx + 3*mu*u*u*cx + u*u*u*t.x;
        var y = mu*mu*mu*s.y + 3*mu*mu*u*s.y + 3*mu*u*u*t.y + u*u*u*t.y;
        ctx.beginPath();
        ctx.arc(x, y, 1.8, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(226,232,238,0.72)';
        ctx.fill();
        pu.t += pu.sp;
        if (pu.t > 1) pu.t = 0;
      }
      requestAnimationFrame(draw);
    }
    draw();
  })();
</script>
